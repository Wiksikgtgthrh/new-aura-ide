{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "extensionHost",
            "request": "launch",
            "name": "Launch Aura Team Plugin",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/aura-team"
            ],
            "outFiles": ["${workspaceFolder}/extensions/aura-team/out/**/*.js"]
        }
    ]
}
