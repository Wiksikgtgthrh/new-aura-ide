{
	"name": "aura-kotlin",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.2.0",
	"publisher": "aura",
	"license": "MIT",
	"engines": { "vscode": "*" },
	"main": "./out/extension.js",
	"activationEvents": ["onLanguage:kotlin", "onView:auraKotlin.androidView", "onCommand:auraKotlin.checkToolchain", "onCommand:auraKotlin.compileFile", "onCommand:auraKotlin.androidDoctor", "onCommand:auraKotlin.newProject", "onCommand:auraKotlin.newFile", "onCommand:auraKotlin.restartLsp", "onCommand:auraKotlin.installLsp", "onCommand:auraKotlin.debugFile", "onCommand:auraKotlin.gradle.sync", "onCommand:auraKotlin.gradle.build", "onCommand:auraKotlin.gradle.clean", "onCommand:auraKotlin.gradle.test", "onCommand:auraKotlin.gradle.release", "onCommand:auraKotlin.gradle.runTask", "onCommand:auraKotlin.syncDependencies", "onCommand:auraKotlin.showClasspath", "onCommand:auraKotlin.android.devices", "onCommand:auraKotlin.android.pickDevice", "onCommand:auraKotlin.android.installApk", "onCommand:auraKotlin.android.logcat", "onCommand:auraKotlin.android.logcatFilter", "onCommand:auraKotlin.android.logcatStop", "onCommand:auraKotlin.android.startEmulator", "onCommand:auraKotlin.android.startAvd", "onCommand:auraKotlin.android.stopEmulator", "onCommand:auraKotlin.android.createAvd", "onCommand:auraKotlin.android.runAndDebug", "onCommand:auraKotlin.android.deviceScreen", "onCommand:auraKotlin.refreshAndroidView", "onDebug", "onDebugAdapterDynamicConfiguration:kotlin", "workspaceContains:build.gradle", "workspaceContains:build.gradle.kts", "workspaceContains:gradlew", "onLanguage:java", "onCommand:auraKotlin.java.restartLsp", "onCommand:auraKotlin.java.organizeImports", "onCommand:auraKotlin.java.installLsp", "onCommand:auraKotlin.java.downloadSources"],
	"categories": ["Programming Languages", "Other"],
	"l10n": "./l10n",
	"contributes": {
		"languages": [{
			"id": "kotlin",
			"aliases": ["Kotlin", "kotlin"],
			"extensions": [".kt", ".kts"],
			"configuration": "./language-configuration.json"
		}],
		"viewsContainers": {
			"activitybar": [{
				"id": "auraKotlin-android",
				"title": "Android",
				"icon": "media/android.svg"
			}]
		},
		"views": {
			"auraKotlin-android": [{
				"id": "auraKotlin.androidView",
				"name": "Android",
				"icon": "media/android.svg",
				"when": "auraPlugin.aura-kotlin.enabled == true"
			}]
		},
		"menus": {
			"view/title": [{
				"command": "auraKotlin.newProject",
				"when": "view == auraKotlin.androidView",
				"group": "navigation@1"
			}, {
				"command": "auraKotlin.newFile",
				"when": "view == auraKotlin.androidView",
				"group": "navigation@2"
			}, {
				"command": "auraKotlin.android.createAvd",
				"when": "view == auraKotlin.androidView",
				"group": "navigation@3"
			}, {
				"command": "auraKotlin.android.logcat",
				"when": "view == auraKotlin.androidView",
				"group": "navigation@4"
			}, {
				"command": "auraKotlin.refreshAndroidView",
				"when": "view == auraKotlin.androidView",
				"group": "navigation@5"
			}],
			"view/item/context": [{
				"command": "auraKotlin.android.startAvd",
				"when": "view == auraKotlin.androidView && viewItem == avd",
				"group": "inline@1"
			}, {
				"command": "auraKotlin.android.deviceScreen",
				"when": "view == auraKotlin.androidView && viewItem == avdRunning",
				"group": "inline@1"
			}, {
				"command": "auraKotlin.android.stopEmulator",
				"when": "view == auraKotlin.androidView && viewItem == avdRunning",
				"group": "inline@2"
			}, {
				"command": "auraKotlin.android.deviceScreen",
				"when": "view == auraKotlin.androidView && viewItem == device",
				"group": "inline@1"
			}, {
				"command": "auraKotlin.android.logcat",
				"when": "view == auraKotlin.androidView && viewItem == device",
				"group": "inline@2"
			}],
			"editor/context": [{
				"command": "auraKotlin.java.organizeImports",
				"when": "editorLangId == java",
				"group": "1_modification@11"
			}, {
				"command": "auraKotlin.java.restartLsp",
				"when": "editorLangId == java",
				"group": "z_commands@1"
			}]
		},
		"viewsWelcome": [{
			"view": "auraKotlin.androidView",
			"contents": "В workspace нет Gradle/Maven-проекта. Откройте папку проекта или создайте новый прямо здесь:\n[$(add) Новый проект Kotlin/Java/Android](command:auraKotlin.newProject)\n[$(new-file) Новый файл Kotlin/Android](command:auraKotlin.newFile)\n[$(vm) Создать эмулятор (AVD)](command:auraKotlin.android.createAvd)"
		}],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"auraKotlin.compilerPath": { "type": "string", "default": "kotlinc", "description": "%configuration.compilerPath%" },
				"auraKotlin.androidSdkPath": { "type": "string", "default": "", "description": "%configuration.androidSdkPath%" },
				"auraKotlin.javaPath": { "type": "string", "default": "java", "description": "%configuration.javaPath%" },
				"auraKotlin.kotlinLspPath": { "type": "string", "default": "kotlin-language-server", "description": "Explicit path or command for the Kotlin Language Server. Leave default to use the bundled/downloaded server automatically (downloaded on first use, ~83 MB, needs JDK 11+)." },
				"auraKotlin.javaLspPath": { "type": "string", "default": "", "description": "%configuration.javaLspPath%" },
				"auraKotlin.java.downloadSources": { "type": "boolean", "default": true, "description": "%configuration.javaDownloadSources%" }
			}
		},
		"commands": [
			{ "command": "auraKotlin.checkToolchain", "title": "%command.checkToolchain%", "category": "Kotlin" },
			{ "command": "auraKotlin.compileFile", "title": "%command.compileFile%", "category": "Kotlin" },
			{ "command": "auraKotlin.androidDoctor", "title": "%command.androidDoctor%", "category": "Kotlin" },
			{ "command": "auraKotlin.newProject", "title": "%command.newProject%", "icon": "$(add)", "category": "Kotlin" },
			{ "command": "auraKotlin.newFile", "title": "%command.newFile%", "icon": "$(new-file)", "category": "Kotlin" },
			{ "command": "auraKotlin.restartLsp", "title": "%command.restartLsp%", "category": "Kotlin" },
			{ "command": "auraKotlin.installLsp", "title": "%command.installLsp%", "category": "Kotlin" },
			{ "command": "auraKotlin.debugFile", "title": "%command.debugFile%", "category": "Kotlin" },
			{ "command": "auraKotlin.gradle.sync", "title": "%command.gradle.sync%", "category": "Gradle" },
			{ "command": "auraKotlin.gradle.build", "title": "%command.gradle.build%", "category": "Gradle" },
			{ "command": "auraKotlin.gradle.clean", "title": "%command.gradle.clean%", "category": "Gradle" },
			{ "command": "auraKotlin.gradle.test", "title": "%command.gradle.test%", "category": "Gradle" },
			{ "command": "auraKotlin.gradle.release", "title": "%command.gradle.release%", "category": "Gradle" },
			{ "command": "auraKotlin.gradle.runTask", "title": "%command.gradle.runTask%", "category": "Gradle" },
			{ "command": "auraKotlin.android.devices", "title": "%command.android.devices%", "category": "Android" },
			{ "command": "auraKotlin.android.pickDevice", "title": "%command.android.pickDevice%", "category": "Android" },
			{ "command": "auraKotlin.android.installApk", "title": "%command.android.installApk%", "category": "Android" },
			{ "command": "auraKotlin.android.logcat", "title": "%command.android.logcat%", "icon": "$(output)", "category": "Android" },
			{ "command": "auraKotlin.android.logcatFilter", "title": "%command.android.logcatFilter%", "category": "Android" },
			{ "command": "auraKotlin.android.logcatStop", "title": "%command.android.logcatStop%", "category": "Android" },
			{ "command": "auraKotlin.android.startEmulator", "title": "%command.android.startEmulator%", "category": "Android" },
			{ "command": "auraKotlin.android.startAvd", "title": "%command.android.startAvd%", "icon": "$(play)", "category": "Android" },
			{ "command": "auraKotlin.android.stopEmulator", "title": "%command.android.stopEmulator%", "category": "Android" },
			{ "command": "auraKotlin.android.createAvd", "title": "%command.android.createAvd%", "icon": "$(vm)", "category": "Android" },
			{ "command": "auraKotlin.android.deviceScreen", "title": "%command.android.deviceScreen%", "icon": "$(device-mobile)", "category": "Android" },
			{ "command": "auraKotlin.android.runAndDebug", "title": "%command.android.runAndDebug%", "category": "Android" },
			{ "command": "auraKotlin.refreshAndroidView", "title": "%command.refreshAndroidView%", "icon": "$(refresh)", "category": "Android" },
			{ "command": "auraKotlin.java.restartLsp", "title": "%command.javaRestartLsp%", "category": "Java" },
			{ "command": "auraKotlin.java.organizeImports", "title": "%command.javaOrganizeImports%", "category": "Java" },
			{ "command": "auraKotlin.java.installLsp", "title": "%command.javaInstallLsp%", "category": "Java" },
			{ "command": "auraKotlin.java.downloadSources", "title": "%command.javaDownloadSources%", "category": "Aura Kotlin" }
		],
		"problemMatchers": [{
			"name": "aura-kotlinc",
			"label": "Kotlin compiler (kotlinc)",
			"owner": "kotlin",
			"source": "kotlinc",
			"fileLocation": ["absolute"],
			"pattern": {
				"regexp": "^(e|w):\\s+(?:file:/{2})?(.+?):(\\d+)(?::(\\d+))?:?\\s+(.*)$",
				"severity": 1,
				"file": 2,
				"line": 3,
				"column": 4,
				"message": 5
			}
		}, {
			"name": "aura-gradle",
			"label": "Gradle / AGP (javac-style and resource errors)",
			"owner": "gradle",
			"fileLocation": ["absolute"],
			"pattern": {
				"regexp": "^(.+?):(\\d+):\\s+(error|warning):\\s+(.*)$",
				"file": 1,
				"line": 2,
				"severity": 3,
				"message": 4
			}
		}],
		"debuggers": [{
			"type": "kotlin",
			"label": "Kotlin (Aura)",
			"languages": ["kotlin", "java"],
			"configurationAttributes": {
				"launch": {
					"required": [],
					"properties": {
						"program": { "type": "string", "description": "Path to the .kt file to compile and debug" },
						"mainClass": { "type": "string", "description": "Fully qualified main class name (alternative to program)" },
						"apk": { "type": "string", "description": "Android: path to the .apk to install and debug on a connected device" },
						"applicationId": { "type": "string", "description": "Android: applicationId (if no apk given, the app must already be installed and debuggable)" },
						"deviceId": { "type": "string", "description": "Android: target device id from adb devices (default: ask)" },
						"activity": { "type": "string", "description": "Android: launch activity like com.example/.MainActivity (default: resolve-activity)" },
						"args": { "type": "array", "items": { "type": "string" }, "description": "Program arguments" },
						"vmArgs": { "type": "array", "items": { "type": "string" }, "description": "Extra JVM arguments" },
						"port": { "type": "number", "description": "JDWP port (default: auto)" }
					}
				},
				"attach": {
					"required": ["port"],
					"properties": {
						"host": { "type": "string", "default": "127.0.0.1", "description": "JDWP host" },
						"port": { "type": "number", "description": "JDWP port of the running JVM" }
					}
				}
			},
			"configurationSnippets": [{
				"label": "Kotlin (Aura): Debug active file",
				"body": { "type": "kotlin", "request": "launch", "name": "Debug active file", "program": "${file}" }
			}, {
				"label": "Kotlin (Aura): Run Android App (F5)",
				"body": { "type": "kotlin", "request": "launch", "name": "Run Android App" }
			}]
		}]
	},
	"scripts": { "compile": "gulp compile-extension:aura-kotlin", "watch": "gulp watch-extension:aura-kotlin", "fetch-server": "node scripts/fetch-lsp.mjs" },
	"devDependencies": { "@types/node": "24.x" }
}
