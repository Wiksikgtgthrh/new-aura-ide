{
	"name": "aura-team",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.9.0",
	"publisher": "aura",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionDependencies": [
		"vscode.git"
	],
	"activationEvents": [
		"onCustomEditor:auraTeam.panel",
		"onCommand:auraTeam.open",
		"onCommand:auraTeam.openProfile",
		"onCommand:auraTeam.commitAll",
		"onCommand:auraTeam.push",
		"onCommand:auraTeam.pull",
		"onCommand:auraTeam.checkout",
		"onView:auraTeam.home",
		"onCommand:auraTeam.invite.open",
		"onCommand:auraTeam.hasEntitlement",
		"onCommand:auraTeam.agggAgent"
	],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:aura-team",
		"watch": "gulp watch-extension:aura-team",
		"test": "node test/run-all.mjs"
	},
	"contributes": {
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"auraTeam.serverUrl": {
					"type": "string",
					"default": "https://auraide.xyz",
					"description": "%configuration.serverUrl%"
				},
				"auraTeam.autoStartServer": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.autoStartServer%"
				},
				"auraTeam.sync.mode": {
					"type": "string",
					"enum": [
						"off",
						"ask",
						"auto"
					],
					"enumDescriptions": [
						"%configuration.syncMode.off%",
						"%configuration.syncMode.ask%",
						"%configuration.syncMode.auto%"
					],
					"default": "off",
					"description": "%configuration.syncMode%"
				},
				"auraTeam.sync.autoPush": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.syncAutoPush%"
				},
				"auraTeam.sync.intervalSeconds": {
					"type": "number",
					"default": 120,
					"minimum": 60,
					"description": "%configuration.syncIntervalSeconds%"
				},
				"auraTeam.sync.commitTemplate": {
					"type": "string",
					"default": "wip: {files}",
					"description": "%configuration.syncCommitTemplate%"
				},
				"auraTeam.git.testCommand": {
					"type": "string",
					"default": "",
					"description": "%configuration.gitTestCommand%"
				},
				"auraTeam.simpleMode": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.simpleMode%"
				},
				"auraTeam.demoMode": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.demoMode%"
				},
				"auraTeam.uiLanguage": {
					"type": "string",
					"enum": [
						"auto",
						"ru",
						"en"
					],
					"enumDescriptions": [
						"%configuration.uiLanguage.auto%",
						"Русский",
						"English"
					],
					"default": "auto",
					"description": "%configuration.uiLanguage%"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "auraTeam",
					"title": "%container.title%",
					"icon": "media/aura-team.svg"
				}
			]
		},
		"views": {
			"auraTeam": [
				{
					"id": "auraTeam.home",
					"name": "%view.home%",
					"type": "webview",
					"when": "auraPlugin.aura-team.enabled == true"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "auraTeam.panel",
				"displayName": "%customEditor.displayName%",
				"selector": [
					{
						"filenamePattern": "*.aura-team"
					}
				],
				"priority": "option"
			}
		],
		"commands": [
			{
				"command": "auraTeam.open",
				"title": "%command.open%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(project)"
			},
			{
				"command": "auraTeam.openProfile",
				"title": "%command.openProfile%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(account)"
			},
			{
				"command": "auraTeam.signIn",
				"title": "%command.signIn%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.signOut",
				"title": "%command.signOut%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.changePassword",
				"title": "%command.changePassword%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.selectTeam",
				"title": "%command.selectTeam%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.connectGitHub",
				"title": "%command.connectGitHub%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.connectAuraApi",
				"title": "%command.connectAuraApi%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.refresh",
				"title": "%command.refresh%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.createTeam",
				"title": "%command.createTeam%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.joinTeam",
				"title": "%command.joinTeam%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.createInvite",
				"title": "%command.createInvite%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.changeRole",
				"title": "%command.changeRole%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.createProject",
				"title": "%command.createProject%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.createTask",
				"title": "%command.createTask%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.storeApiKey",
				"title": "%command.storeApiKey%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.disableApiKey",
				"title": "%command.disableApiKey%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.uploadArchive",
				"title": "%command.uploadArchive%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.downloadArchive",
				"title": "%command.downloadArchive%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.openBoard",
				"title": "%command.openBoard%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(project)"
			},
			{
				"command": "auraTeam.toggleSimpleMode",
				"title": "%command.toggleSimpleMode%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(settings-gear)"
			},
			{
				"command": "auraTeam.getProject",
				"title": "%command.getProject%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(repo-clone)"
			},
			{
				"command": "auraTeam.saveWork",
				"title": "%command.saveWork%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "auraTeam.updateProject",
				"title": "%command.updateProject%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(sync)"
			},
			{
				"command": "auraTeam.undoChanges",
				"title": "%command.undoChanges%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.revertLastCommit",
				"title": "%command.revertLastCommit%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.restoreFile",
				"title": "%command.restoreFile%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.relink",
				"title": "%command.relink%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.history",
				"title": "%command.history%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.commitAll",
				"title": "%command.commitAll%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(check)"
			},
			{
				"command": "auraTeam.push",
				"title": "%command.push%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "auraTeam.pull",
				"title": "%command.pull%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(cloud-download)"
			},
			{
				"command": "auraTeam.checkout",
				"title": "%command.checkout%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(git-branch)"
			},
			{
				"command": "auraTeam.getState",
				"title": "%command.getState%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			},
			{
				"command": "auraTeam.invite.open",
				"title": "%command.inviteOpen%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(person-add)"
			},
			{
				"command": "auraTeam.syncNow",
				"title": "%command.syncNow%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true",
				"icon": "$(sync)"
			},
			{
				"command": "auraTeam.toggleAutoPush",
				"title": "%command.toggleAutoPush%",
				"category": "%category.team%",
				"enablement": "auraPlugin.aura-team.enabled == true"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "auraTeam.getState",
					"when": "false"
				}
			]
		}
	},
	"devDependencies": {
		"@types/node": "24.x",
		"jsdom": "^30.1.3"
	}
}
