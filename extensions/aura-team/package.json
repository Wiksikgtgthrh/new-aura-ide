{
	"name": "aura-team",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.9.0",
	"publisher": "aura",
	"icon": "media/aura-team.svg",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionDependencies": [
		"vscode.git"
	],
	"activationEvents": [
		"onCustomEditor:auraTeam.panel",
		"onCommand:auraTeam.open",
		"onCommand:auraTeam.openProfile",
		"onCommand:auraTeam.commitAll",
		"onCommand:auraTeam.push",
		"onCommand:auraTeam.pull",
		"onCommand:auraTeam.checkout",
		"onView:auraTeam.home"
	],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:aura-team",
		"watch": "gulp watch-extension:aura-team"
	},
	"contributes": {
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"auraTeam.serverUrl": {
					"type": "string",
					"default": "https://auraide.xyz",
					"description": "%configuration.serverUrl%"
				},
				"auraTeam.sync.autoPush": {
					"type": "boolean",
					"default": false,
					"description": "Automatically commit and push all changes after saving files"
				},
				"auraTeam.sync.intervalSeconds": {
					"type": "number",
					"default": 120,
					"minimum": 15,
					"description": "How often to pull changes from GitHub (seconds)"
				},
				"auraTeam.sync.commitTemplate": {
					"type": "string",
					"default": "wip: {files}",
					"description": "Commit message template for auto-push. Supports {files} and {date}"
				},
				"auraTeam.githubClientId": {
					"type": "string",
					"default": "",
					"description": "%configuration.githubClientId%"
				},
				"auraTeam.simpleMode": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.simpleMode%"
				},
				"auraTeam.demoMode": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.demoMode%"
				},
				"auraTeam.uiLanguage": {
					"type": "string",
					"enum": ["ru", "en", "auto"],
					"enumDescriptions": ["Русский", "English", "Язык интерфейса IDE"],
					"default": "ru",
					"description": "%configuration.uiLanguage%"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "auraTeam",
					"title": "%container.title%",
					"icon": "media/aura-team.svg"
				}
			]
		},
		"views": {
			"auraTeam": [
				{ "id": "auraTeam.home", "name": "%view.home%", "type": "webview" }
			]
		},
		"customEditors": [
			{
				"viewType": "auraTeam.panel",
				"displayName": "Team",
				"selector": [
					{ "filenamePattern": "*.aura-team" }
				],
				"priority": "option"
			}
		],
		"commands": [
			{ "command": "auraTeam.open", "title": "%command.open%", "category": "Team", "icon": "$(project)" },
			{ "command": "auraTeam.openProfile", "title": "%command.openProfile%", "category": "Team", "icon": "$(account)" },
			{ "command": "auraTeam.signIn", "title": "%command.signIn%", "category": "Team" },
			{ "command": "auraTeam.signOut", "title": "%command.signOut%", "category": "Team" },
			{ "command": "auraTeam.changePassword", "title": "%command.changePassword%", "category": "Team" },
			{ "command": "auraTeam.selectTeam", "title": "%command.selectTeam%", "category": "Team" },
			{ "command": "auraTeam.connectGitHub", "title": "%command.connectGitHub%", "category": "Team" },
			{ "command": "auraTeam.connectAuraApi", "title": "%command.connectAuraApi%", "category": "Team" },
			{ "command": "auraTeam.refresh", "title": "%command.refresh%", "category": "Team" },
			{ "command": "auraTeam.createTeam", "title": "%command.createTeam%", "category": "Team" },
			{ "command": "auraTeam.joinTeam", "title": "%command.joinTeam%", "category": "Team" },
			{ "command": "auraTeam.createInvite", "title": "%command.createInvite%", "category": "Team" },
			{ "command": "auraTeam.changeRole", "title": "%command.changeRole%", "category": "Team" },
			{ "command": "auraTeam.createProject", "title": "%command.createProject%", "category": "Team" },
			{ "command": "auraTeam.createTask", "title": "%command.createTask%", "category": "Team" },
			{ "command": "auraTeam.storeApiKey", "title": "%command.storeApiKey%", "category": "Team" },
			{ "command": "auraTeam.disableApiKey", "title": "%command.disableApiKey%", "category": "Team" },
			{ "command": "auraTeam.uploadArchive", "title": "%command.uploadArchive%", "category": "Team" },
			{ "command": "auraTeam.downloadArchive", "title": "%command.downloadArchive%", "category": "Team" },
			{ "command": "auraTeam.openBoard", "title": "%command.openBoard%", "category": "Team", "icon": "$(project)" },
			{ "command": "auraTeam.toggleSimpleMode", "title": "%command.toggleSimpleMode%", "category": "Team", "icon": "$(settings-gear)" },
			{ "command": "auraTeam.getProject", "title": "%command.getProject%", "category": "Team", "icon": "$(repo-clone)" },
			{ "command": "auraTeam.saveWork", "title": "%command.saveWork%", "category": "Team", "icon": "$(cloud-upload)" },
			{ "command": "auraTeam.updateProject", "title": "%command.updateProject%", "category": "Team", "icon": "$(sync)" },
			{ "command": "auraTeam.undoChanges", "title": "%command.undoChanges%", "category": "Team" },
			{ "command": "auraTeam.revertLastCommit", "title": "%command.revertLastCommit%", "category": "Team" },
			{ "command": "auraTeam.restoreFile", "title": "%command.restoreFile%", "category": "Team" },
			{ "command": "auraTeam.relink", "title": "%command.relink%", "category": "Team" },
			{ "command": "auraTeam.history", "title": "%command.history%", "category": "Team" },
			{ "command": "auraTeam.commitAll", "title": "%command.commitAll%", "category": "Team", "icon": "$(check)" },
			{ "command": "auraTeam.push", "title": "%command.push%", "category": "Team", "icon": "$(cloud-upload)" },
			{ "command": "auraTeam.pull", "title": "%command.pull%", "category": "Team", "icon": "$(cloud-download)" },
			{ "command": "auraTeam.checkout", "title": "%command.checkout%", "category": "Team", "icon": "$(git-branch)" },
			{ "command": "auraTeam.getState", "title": "%command.getState%", "category": "Team" },
			{ "command": "auraTeam.syncNow", "title": "Sync Now", "category": "Team", "icon": "$(sync)" },
			{ "command": "auraTeam.toggleAutoPush", "title": "Toggle Auto-Push", "category": "Team" }
		],
		"menus": {
			"commandPalette": [
				{ "command": "auraTeam.getState", "when": "false" }
			]
		}
	},
	"devDependencies": {
		"@types/node": "24.x"
	}
}
